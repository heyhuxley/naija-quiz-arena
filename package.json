{
  "name": "naija-quiz-arena",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"workers/**/*.ts\" \"supabase/functions/**/*.ts\" \"*.{ts,js,json,jsonc}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"workers/**/*.ts\" \"supabase/functions/**/*.ts\" \"*.{ts,js,json,jsonc}\" \".github/workflows/*.yml\"",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "typecheck": "react-router typegen && tsc",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check"
  }
}
